switch(FEAT_SIGNALS, SELF, signal_switch_block_traditional, [
        STORE_TEMP(hasbit(extra_callback_info2, 24) ? param[10] : 0, 0x100),
        (extra_callback_info2 & 0x000000FF)
    ]) {
    0: signals_block_red;
    1: signals_block_green;
    2: signals_block_y;
    3: signals_block_yy;
}

switch(FEAT_SIGNALS, SELF, signal_switch_block_new, [
        STORE_TEMP(param[10] + (hasbit(extra_callback_info2, 24) ? 2 : 1), 0x100),
        (extra_callback_info2 & 0x000000FF)
    ]) {
    0: signals_new_block_red;
    1: signals_new_block_green;
    2: signals_new_block_y;
    3: signals_new_block_yy;
}

switch (FEAT_SIGNALS, SELF, signal_switch_block, param_block_style) {
    0: signal_switch_block_traditional;
    1: signal_switch_block_new;
}

//Main signals. 3-aspect, two way
switch(FEAT_SIGNALS, SELF, signal_switch_pbs_std, [
        STORE_TEMP(param[10] + (hasbit(extra_callback_info2, 24) ? 2 : 1), 0x100),
        (extra_callback_info2 & 0x000000FF)
    ]) {
    0: signals_pbs_red;
//    1: signals_pbs_green;
    2: signals_pbs_y;
//    3: signals_pbs_yy;
    signals_pbs_green;
}



switch(FEAT_SIGNALS, SELF, signal_switch_pbs, signal_vertical_clearance < param[11]) {
    default: signal_switch_pbs_std;
    1: signal_switch_block_new;
}

//Main signals, 3 aspect
switch(FEAT_SIGNALS, SELF, signal_switch_pbs_oneway, [
        STORE_TEMP(param[10] + (hasbit(extra_callback_info2, 24) ? 2 : 1), 0x100),
        (extra_callback_info2 & 0x000000FF) | (signal_vertical_clearance < param[11] ? 0x100 : 0)
    ]) {
    0: signals_pbs_oneway_red;
    1: signals_pbs_oneway_green;
    2: signals_pbs_oneway_y;
//    3: signals_pbs_oneway_yy;

    0x100: signals_pbs_oneway_red_short;
    0x101: signals_pbs_oneway_green_short;
    0x102: signals_pbs_oneway_y_short;
//    0x103: signals_pbs_oneway_yy_short;
    signals_pbs_oneway_green; //default, catches unused higher aspects
}

//Main signals, 4 aspect
switch(FEAT_SIGNALS, SELF, signal_switch_pbs4_oneway, [
        STORE_TEMP(param[10] + (hasbit(extra_callback_info2, 24) ? 2 : 1), 0x100),
        (extra_callback_info2 & 0x000000FF) | (signal_vertical_clearance < param[11] ? 0x100 : 0)
    ]) {
    0: signals_pbs4_red; //signals_pbs4_oneway_red; //oneway removed temp for development
    1: signals_pbs4_green;
    2: signals_pbs4_y;
    3: signals_pbs4_yy;

 //!!! replace these with main signals instead, after bridge testing
    0x100: signals_pbs_oneway_red_short;
    0x101: signals_pbs_oneway_green_short;
    0x102: signals_pbs_oneway_y_short;
    0x103: signals_pbs_oneway_yy_short;
    signals_pbs4_oneway_green; //default, catches unused higher aspects
}

switch(FEAT_SIGNALS, SELF, signal_switch_pbs4, [
        STORE_TEMP(param[10] + (hasbit(extra_callback_info2, 24) ? 2 : 1), 0x100),
        (extra_callback_info2 & 0x000000FF)
    ]) {
    0: signals_pbs4_red;
    1: signals_pbs4_green;
    2: signals_pbs4_y;
    3: signals_pbs4_yy;
    signals_pbs4_green;
}




//Shunt signals, 3 aspects.  
//stop ..  
//slow .·  
//  go :
switch(FEAT_SIGNALS, SELF, signal_switch_shunt, [
        STORE_TEMP(hasbit(extra_callback_info2, 24) ? param[10] : 0, 0x100),
        (extra_callback_info2 & 0x000000FF)
    ]) {
    0: signals_shunt_stop;
    2: signals_shunt_slow; 
    signals_shunt_go;
}

