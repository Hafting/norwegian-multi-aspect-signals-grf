switch(FEAT_SIGNALS, SELF, signal_switch_shunt_no_entry, [
        STORE_TEMP(hasbit(extra_callback_info2, 24) ? param[10] : 0, 0x100),
        (extra_callback_info2 & 0x000000FF)
    ]) {
    signals_shunt_no_entry;
}
*/

/*
switch(FEAT_SIGNALS, SELF, signal_switch_banner_block, [
        STORE_TEMP(param[10] + (hasbit(extra_callback_info2, 24) ? 2 : 1), 0x100),
        (extra_callback_info2 & 0x000000FF)
    ]) {
    0: signals_block_banner_on;
    2: signals_block_banner_on;
    signals_block_banner_off;
}
*/

/* Simplified or temporary signals
   Simplified, for that coal line with only two trains on it
   Temporary, for work on the railroad.
   Just red and green
*/
switch(FEAT_SIGNALS, SELF, signal_switch_tmp_pbs, [
        STORE_TEMP(param[10] + (hasbit(extra_callback_info2, 24) ? 2 : 1), 0x100),
        (extra_callback_info2 & 0x000000FF)
    ]) {
    0: signals_twolamp_red; //STOP
    signals_twolamp_green; //GO
}

switch(FEAT_SIGNALS, SELF, signal_switch_tmp_pbs_oneway, [
        STORE_TEMP(param[10] + (hasbit(extra_callback_info2, 24) ? 2 : 1), 0x100),
        (extra_callback_info2 & 0x000000FF)
    ]) {
     0: signals_twolamp_red_ow; //STOP
    signals_twolamp_green_ow; //GO 
}


//Level crossing signals. Red or white, two-aspect
//Note, no actual connection to any level crossing. But this is
//what you see in Norway, so...
switch(FEAT_SIGNALS, SELF, signal_switch_levelcross_pbs, [
        STORE_TEMP(param[10] + (hasbit(extra_callback_info2, 24) ? 2 : 1), 0x100),
        (extra_callback_info2 & 0x000000FF)
    ]) {
    0: signals_twolamp_red; //Level crossing closed for trains
    signals_twolamp_white;  //Level crossing open for trains
}

switch(FEAT_SIGNALS, SELF, signal_switch_levelcross_pbs_oneway, [
        STORE_TEMP(param[10] + (hasbit(extra_callback_info2, 24) ? 2 : 1), 0x100),
        (extra_callback_info2 & 0x000000FF)
    ]) {
    0: signals_twolamp_red_ow; //Level crossing closed for trains
    signals_twolamp_white_ow;  //Level crossing open for trains
}

//Distant level crossing signals
//Put one in front of a level crossing signal, with no railway intersections
//or other signals between.
//violet: informs that the next level crossing signal is red
//white: informs that the next leve crossing signal is white
//One may put them anywhere, but they are meant for warning about the crossing
switch(FEAT_SIGNALS, SELF, signal_switch_dist_levelcross_pbs, [
        STORE_TEMP(param[10] + (hasbit(extra_callback_info2, 24) ? 2 : 1), 0x100),
        (extra_callback_info2 & 0x000000FF)
    ]) {

    0..2: signals_twolamp_violet; //Level crossing closed for trains
    signals_twolamp_white;  //Level crossing open for trains


/*  TEST SETUP and oddball results. Distant signals are tricky.
    0: signals_twolamp_violet_ow; //starts here, in front of red signal. Here again, train got to the signal post.
    1: signals_twolamp_yellow;    //not happening
    2: signals_twolamp_red;       //fast train reserves through this signal, but not the main one I.e. the main remains red.
    3: signals_twolamp_yelgreen;  //train reserved through the main signal, main signal got white
    signals_twolamp_white_ow;     //not happening
*/
}
/* TEST RESULTS, different from oneway:
0: main signal is STOP, or the locomotive just went past this signal
1: don't happen
2: train RESERVED through this signal, but not the main signal which must therefore be STOP
   Two way signals are STOP when nobody is trying, especially in front of a crossing.
3: train RESERVED through main signal, setting it to GO. 

Conclusion: 0..2: Show stop. Otherwise, show GO

*/

switch(FEAT_SIGNALS, SELF, signal_switch_dist_levelcross_pbs_oneway, [
        STORE_TEMP(param[10] + (hasbit(extra_callback_info2, 24) ? 2 : 1), 0x100),
        (extra_callback_info2 & 0x000000FF)
    ]) {

/*  TEST SETUP AND RESULTS. Distant signals are tricky. Also, twoway is different.
    0: signals_twolamp_violet_ow; //State when a locomotive just passed the signal. Unavoidable
    1: signals_twolamp_yellow; //don't happen
    2: signals_twolamp_red;       //initial state, in front of a red lvl signal. Goes here after the train passes the main signal
    3: signals_twolamp_yelgreen;  //in front of white lvl signal, train allocated a path
    signals_twolamp_white_ow;  //don't happen
*/
    0..2: signals_twolamp_violet_ow; //Train just passed, this signal or the main one.
    signals_twolamp_white_ow;    //In front of a white(GO) main signal
}

/*
  Distant signals. For informing trains about the next main signal.
  Put it in front of a main signal, with no rail intersections between.

  Failure modes:
  1. Distant signals are reset to state 0 as the locomotive pass them. 
     Wrong, so best effort is to set them the way they should look when the
     locomotive also passes the main signal (setting it to STOP). 
     The duration of error is short,   
     and no train will come here because the track is occupied by THIS train.
  2. Distant signals are updated mostly when a train has a reservation through them.
     With a long distance between the distant signal and the main signal, the main
     may go through several aspects after the train passed the distant signal. The 
     distant signal gets no updates. Still, the best-effort fix for (1) helps here too. 
*/

switch(FEAT_SIGNALS, SELF, signal_switch_distant_pbs, [
        STORE_TEMP(param[10] + (hasbit(extra_callback_info2, 24) ? 2 : 1), 0x100),
        (extra_callback_info2 & 0x000000FF)
    ]) {
    0: signals_twolamp_yellow;   //This state when a train just passed the signal post
    1: signals_twolamp_green;    //Path gets reserved to a green full speed signal
    2: signals_twolamp_yellow;   //Path gets reserved to a red stop signal
    3: signals_twolamp_yelgreen; //Path gets reserved to a green slow signal (first extra aspect)
    signals_twolamp_green;       //Other cases, should not happen (load a 5-aspect signal grf)
}

//Distant signals, one way
switch(FEAT_SIGNALS, SELF, signal_switch_distant_pbs_oneway, [
        STORE_TEMP(param[10] + (hasbit(extra_callback_info2, 24) ? 2 : 1), 0x100),
        (extra_callback_info2 & 0x000000FF)
    ]) {

    0: signals_twolamp_yellow_ow;   //This state when a train just passed the signal post
    1: signals_twolamp_green_ow;    //Path gets reserved to a green full speed signal
    2: signals_twolamp_yellow_ow;   //Path gets reserved to a red stop signal
    3: signals_twolamp_yelgreen_ow; //Path gets reserved to a green slow signal (first extra aspect)
    signals_twolamp_green_ow;       //Other cases, should not happen (load a 5-aspect signal grf)

}

/*
Norwegian rules for combined signals (main signal and dwarf signal on the same mast)
Train routed through green main signals: dwarf signal must show "go"
Main signal red and no shunting: dwarf signal must show "stop"
Main signal red, but shunting allowed: dwarf signal overrides the main signal using "go" or "slow"
UK is different, they turn the dwarf signal off in some cases.
*/


switch(FEAT_SIGNALS, SELF, signal_switch_combined_pbs, [
        STORE_TEMP(param[10] + (hasbit(extra_callback_info2, 24) ? 2 : 1), 0x100),
        (extra_callback_info2 & 0x000000FF) | (signal_vertical_clearance < param[11] ? 0x100 : 0)
    ]) {
    0: signals_combined_red;
    1: signals_combined_green;
    2: signals_combined_y;
    3: signals_combined_green; //We do 3 aspects only
    0xFF: signals_combined_shunt;

    0x100: signals_combined_red_short;
    0x101: signals_combined_green_short;
    0x102: signals_combined_y_short;
    0x103: signals_combined_green_short; //We do 3 aspects only
    0x1FF: signals_combined_shunt_short;
}

switch(FEAT_SIGNALS, SELF, signal_switch_combined_pbs_oneway, [
        STORE_TEMP(param[10] + (hasbit(extra_callback_info2, 24) ? 2 : 1), 0x100),
        (extra_callback_info2 & 0x000000FF) | (signal_vertical_clearance < param[11] ? 0x100 : 0)
    ]) {
    0: signals_combined_oneway_red;
    1: signals_combined_oneway_green;
    2: signals_combined_oneway_y;
    3: signals_combined_oneway_green; //3 aspects only
    0xFF: signals_combined_oneway_shunt;

    0x100: signals_combined_oneway_red_short;
    0x101: signals_combined_oneway_green_short;
    0x102: signals_combined_oneway_y_short;
    0x103: signals_combined_oneway_green_short; //3 aspects only
    0x1FF: signals_combined_oneway_shunt_short;
}

//WHAT are the first-column numbers? !!! look it up !!!
//First column number breakdown
//The last hex digit matches the custom style number, deciding which menu the signal appears on
//Style 0 apparently replaces the stock signals in openttd
//Other digits must make the number unique, or nmlc complains. 
//extra_callback_info2: RRTTVVSS, (RR reserved), masking picks the TTVV part.
switch(FEAT_SIGNALS, SELF, switch_signals, (extra_callback_info2 & 0x00FFFF00) | signal_style) {
        0x0: signal_switch_block;        //light, block
    0x40000: signal_switch_pbs4;
    0x50000: signal_switch_pbs4_oneway;
    0x40008: signal_switch_pbs;          //light, PBS
    0x50008: signal_switch_pbs_oneway;   //light, PBS oneway
    0x40001: signal_switch_shunt;        //shunt
    0x40002: signal_switch_shunt;        //shunt (opposite)
//    0x70001: signal_switch_shunt_no_entry; //shunt no entry
//    0x70002: signal_switch_shunt_no_entry; //shunt no entry (opposite)
//        0x3: signal_switch_banner_block; //banner, block
    0x40003: signal_switch_distant_pbs;   //distant, PBS
    0x50003: signal_switch_distant_pbs_oneway; //distant, PBS oneway
    0x40004: signal_switch_combined_pbs;        //combined, PBS
    0x50004: signal_switch_combined_pbs_oneway; //combined, PBS oneway
    0x40005: signal_switch_levelcross_pbs;      //Plain PBS, meant for level crossings
    0x50005: signal_switch_levelcross_pbs_oneway;
    0x40006: signal_switch_dist_levelcross_pbs; //Distant signal, informing on the l.c. signal
    0x50006: signal_switch_dist_levelcross_pbs_oneway;
    0x40007: signal_switch_tmp_pbs;             //Simplified/temporary signal
    0x50007: signal_switch_tmp_pbs_oneway;
    CB_FAILED;
}

item (FEAT_SIGNALS, custom_signals, 0) {
    property {
        enable_restricted_signals: param_routing_restriction;
        enable_signal_recolour: 1;
        extra_aspects: 2; //Noen bruker 2, noen 1, noen 0.
    }

    graphics {
        switch_signals;
    }
}

